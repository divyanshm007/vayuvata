# Copy values into environment variables (or `dotnet user-secrets set`). Never commit real values.
# ASP.NET Core maps "__" to ":" in config keys.
ConnectionStrings__Default=Server=localhost;Database=VayuVata;Trusted_Connection=True;TrustServerCertificate=True;
Jwt__Key=<random string, at least 32 chars, e.g. output of: openssl rand -base64 48>
Bootstrap__SuperAdminEmail=<first super admin email>
Bootstrap__SuperAdminPassword=<strong password, min 10 chars>
Bootstrap__SuperAdminName=Super Admin
ASPNETCORE_ENVIRONMENT=Development
# Development only; lets a registered device post without X-Device-Key (never enable in production):
DeviceAuth__AllowMissingKeyInDevelopment=false
