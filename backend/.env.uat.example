# Copy to .env.uat and fill in. .env.uat must NOT be committed (it is git-ignored).
# SQL Server SA password: >= 8 chars with upper, lower, digit and symbol (SQL Server complexity rules).
SA_PASSWORD=<strong SQL Server sa password>
# JWT signing key, >= 32 random characters (e.g. openssl rand -base64 48). Changing it signs everyone out.
JWT_KEY=<random 48+ char string, no trailing whitespace>
# First SuperAdmin, created only if no SuperAdmin exists yet.
SUPERADMIN_EMAIL=<superadmin email>
SUPERADMIN_PASSWORD=<strong password, >= 10 chars>
# Host port for the API (default 8081) and optional switches.
API_PORT=8081
SWAGGER_ENABLED=true
CORS_ORIGIN=<UAT frontend origin, e.g. https://uat.example.com>
