# Base URL of the VayuVata API (no trailing slash, without /api/v1)
VITE_API_BASE_URL=http://localhost:5080

# Map tiles (optional). Default = public OpenStreetMap server: free, but best-effort with no guarantee, and heavy or commercial
# use can be blocked without notice. For production use a hosted provider or your own tile server:
# VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.maptiler.com/copyright/">MapTiler</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# VITE_MAP_MAX_ZOOM=19
